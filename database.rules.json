{
  "rules": {
    ".read": false,
    ".write": false,
    "sig": {
      ".read": "auth != null && (auth.token.email == 'design.onegin@gmail.com' || auth.token.email == 'raz.brandstudio@gmail.com' || auth.token.email == 'bot@raz.kz')",
      ".write": "auth != null && (auth.token.email == 'design.onegin@gmail.com' || auth.token.email == 'raz.brandstudio@gmail.com' || auth.token.email == 'bot@raz.kz')",
      "annaQ": { ".indexOn": ["at", "status"] },
