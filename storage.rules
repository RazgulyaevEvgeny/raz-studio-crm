rules_version = '2';
// Фото и файлы видят и загружают только вошедшие сотрудники. Один файл не больше 20 МБ.
service firebase.storage {
  match /b/{bucket}/o {
    match /files/{fileName} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/mp4|video/webm|application/pdf');
    }
  }
}
