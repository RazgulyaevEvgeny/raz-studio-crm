# Настройки WhatsApp-бота. install.bat копирует этот файл в .env и открывает его в Блокноте.
# Заполните значения после знака =, сохраните (Ctrl+S) и закройте Блокнот.

# Учёт (Firebase). Эти два значения уже верные, их не трогать.
FIREBASE_API_KEY=AIzaSyCNpsnF-9swN11uS2L22-w9cXF45G54Hj0
FIREBASE_PROJECT=raz-studio-5a486

# Вход бота в учёт: отдельный пользователь в Firebase → Authentication → Users → Add user.
BOT_EMAIL=
BOT_PASSWORD=

# Бесплатный ключ нейросети Google Gemini: aistudio.google.com → Get API key → Create API key (карта не нужна).
GEMINI_API_KEY=

# Необязательно, платно: ключ Claude (console.anthropic.com). Если заполнить, отвечать будет Claude вместо Gemini.
ANTHROPIC_API_KEY=

# Уведомления на телефон в Telegram (бесплатно): токен бота от @BotFather. Потом каждому, кто хочет уведомления, написать боту /start
TELEGRAM_BOT_TOKEN=
